{% comment %}
  - rename 0-name in asset file names
  - rename name-section, name__, __ classes, data-name-*
  - update schema: name, class, presets
  - drop unused blocks (markup + schema settings)
  - no JS: remove <script>, use <div> instead of name-section
{% endcomment %}

{{ '0-name.out.css' | asset_url | stylesheet_tag }}
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js" defer></script>
<script src="{{ '0-name.out.js' | asset_url }}" defer></script>

<name-section
  class="name__wrapper color-{{ section.settings.color_scheme }} page-width"
  style="
    --section-margin-top: {{ section.settings.margin_top }}px;
    --section-margin-bottom: {{ section.settings.margin_bottom }}px;
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --section-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --section-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    {% comment %} --section-bg-mobile: url({{ section.settings.image_mobi | image_url: width: 750 }}); {% endcomment %}
    {% comment %} --section-bg-desktop: url({{ section.settings.image_desk | image_url: width: 1920 }}); {% endcomment %}
  "
>
  <header
    {% comment %}class='page-width'{% endcomment %}
  >
    {%- if section.settings.title != blank -%}
      <h2
        class="__title {{ section.settings.title_size }}"
        data-name-title
        style="font-family:{{ section.settings.title_font_family }}; text-align:{{ section.settings.title_align }};"
      >
        {{ section.settings.title | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}
      </h2>
    {%- endif -%}

    {%- if section.settings.subtitle != blank -%}
      <div class="__subtitle">{{ section.settings.subtitle }}</div>
    {%- endif -%}

    {%- if section.settings.btn_name != blank -%}
      <a
        class="__link"
        {% if section.settings.btn_url == blank %}
          role="link" aria-disabled="true"
        {% else %}
          href="{{ section.settings.btn_url }}"
        {% endif %}
      >
        {{- section.settings.btn_name -}}
      </a>
    {%- endif -%}
  </header>

  <div
    class="
      __container
      {% comment %}page-width{% endcomment %}
    "
  >
    {%- assign content_blocks = section.blocks | where: 'type', 'base_block' -%}
    {%- for block in section.blocks -%}
      {%- if block.type == '@app' -%}
        {% render block %}
      {%- endif -%}
    {%- endfor -%}

    <div class="__banner--wrapp {{ section.settings.banner_position }}">
      {% if section.settings.image_desk != blank and section.settings.video == blank %}
        {%- liquid
          assign loading = 'lazy'
          assign priority = 'auto'
          if section.index == 1
            assign loading = 'eager'
            assign priority = 'high'
          endif
        -%}
        <picture class="__media--wrapp">
          {%- if section.settings.image_mobi != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ section.settings.image_mobi | image_url: width: 375 }} 375w,
                {{ section.settings.image_mobi | image_url: width: 750 }} 750w,
                {{ section.settings.image_mobi | image_url: width: 1100 }} 1100w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{ section.settings.image_desk | image_url: width: 2560 | image_tag: class: '__image', widths: '750, 1100, 1500, 1920, 2560', sizes: '100vw', loading: loading, fetchpriority: priority }}
        </picture>
      {% elsif section.settings.video != blank %}
        {% assign image_poster = section.settings.image_desk | default: section.settings.video.preview_image | image_url: width: 1920 %}
        <figure class="__media--wrapp">
          {{- section.settings.video | video_tag: image_size: '1920x', class: '__video', poster: image_poster, controls: true, loop: true, muted: true, autoplay: true, playsinline: true -}}
        </figure>
      {% endif %}

      <div class="__banner-content">
        {%- if section.settings.title != blank -%}
          <h2 class="__title {{ section.settings.title_size }}" data-name-title>{{ section.settings.title | replace: '</p><p>', '<br>' | remove: '<p>' | remove: '</p>' }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <div class="__subtitle">{{ section.settings.subtitle }}</div>
        {%- endif -%}
        {%- if section.settings.btn_name != blank -%}
          <a
            class="__link"
            {% if section.settings.btn_url == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ section.settings.btn_url }}"
            {% endif %}
          >
            {{- section.settings.btn_name -}}
          </a>
        {%- endif -%}
      </div>
    </div>

    <div class="__slider--wrapp swiper" data-name-swiper data-columns="{{ section.settings.slider_columns }}">
      <div class="swiper-wrapper">
        {%- for block in content_blocks -%}
          <article class="swiper-slide" {{ block.shopify_attributes }}>
            <figure class="__media--wrapp">
              {%- if block.settings.title != blank -%}
                <figcaption class="__badge">{{ block.settings.title }}</figcaption>
              {%- endif -%}
              {%- if block.settings.video != blank -%}
                {%- assign poster = block.settings.image | default: block.settings.video.preview_image | image_url: width: 1100 -%}
                {{ block.settings.video | video_tag: class: '__video', poster: poster, autoplay: true, muted: true, loop: true, playsinline: true }}
              {%- elsif block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 1100 | image_tag: class: '__image', widths: '360, 550, 720, 1100', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
              {%- else -%}
                {{ 'image' | placeholder_svg_tag }}
              {%- endif -%}
            </figure>

            <div class="__content--wrapp">
              <h3 class="__title">{{ block.settings.title }}</h3>
              <div class="__description">{{ block.settings.description | strip_html | truncate: 100 }}</div>

              {%- if block.settings.btn_name != blank -%}
                <a
                  class="__link"
                  {% if block.settings.btn_url == blank %}
                    role="link" aria-disabled="true"
                  {% else %}
                    href="{{ block.settings.btn_url }}"
                  {% endif %}
                >
                  {{- block.settings.btn_name -}}
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>

      <button
        type="button"
        class="swiper-button-prev"
        data-name-swiper-prev
        aria-label="Previous slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path d="M20 0.5C30.7696 0.5 39.5 9.23045 39.5 20C39.5 30.7696 30.7696 39.5 20 39.5C9.23045 39.5 0.5 30.7696 0.5 20C0.5 9.23045 9.23045 0.5 20 0.5Z" stroke="#ECEBDE"/>
          <path d="M22.5 13.3337L15.8333 20.0003L22.5 26.667" stroke="#727270" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>
      <button
        type="button"
        class="swiper-button-next"
        data-name-swiper-next
        aria-label="Next slide"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path d="M20 0.5C30.7696 0.5 39.5 9.23045 39.5 20C39.5 30.7696 30.7696 39.5 20 39.5C9.23045 39.5 0.5 30.7696 0.5 20C0.5 9.23045 9.23045 0.5 20 0.5Z" stroke="#ECEBDE"/>
          <path d="M22.5 13.3337L15.8333 20.0003L22.5 26.667" stroke="#727270" stroke-width="1.66667" stroke-linecap="round" stroke-linejoin="round" transform="rotate(180 20 20)"/>
        </svg>
      </button>

      <div class="swiper-pagination" data-name-swiper-pagination></div>
    </div>

    <div class="__grid--wrapp" style="--grid-cols: {{ section.settings.grid_columns }};">
      {%- for block in content_blocks -%}
        <article
          {{ block.shopify_attributes }}
          style="
            grid-column: span {{ block.settings.col_span }};
            grid-row: span {{ block.settings.row_span }};
          "
        >
          <figure class="__media--wrapp">
            {%- if block.settings.title != blank -%}
              <figcaption class="__badge">{{ block.settings.title }}</figcaption>
            {%- endif -%}

            {%- if block.settings.video != blank -%}
              {%- assign poster = block.settings.image | default: block.settings.video.preview_image | image_url: width: 1100 -%}
              {{ block.settings.video | video_tag: class: '__video', poster: poster, autoplay: true, muted: true, loop: true, playsinline: true }}
            {%- elsif block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 1100 | image_tag: class: '__image', widths: '360, 550, 720, 1100', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </figure>

          <div class="__content--wrapp">
            <h3 class="__title">{{ block.settings.title }}</h3>
            <div class="__description">{{ block.settings.description | strip_html | truncate: 100 }}</div>

            {%- if block.settings.btn_name != blank -%}
              <a
                class="__link"
                {% if block.settings.btn_url == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ block.settings.btn_url }}"
                {% endif %}
              >
                {{- block.settings.btn_name -}}
              </a>
            {%- endif -%}

            <p class="__reviews" role="img" aria-label="{{ block.settings.number }}/5">
              {% for i in (1..5) %}
                <svg
                  {% if i <= block.settings.number %}
                    class="active"
                  {% endif %}
                  xmlns="http://www.w3.org/2000/svg"
                  width="14"
                  height="14"
                  viewBox="0 0 14 14"
                  aria-hidden="true"
                >
                  <path d="M6.18145 0.542997C6.41666 -0.180892 7.44077 -0.180893 7.67597 0.542996L8.77293 3.91909C8.87812 4.24283 9.1798 4.46201 9.52019 4.46201H13.07C13.8312 4.46201 14.1476 5.436 13.5319 5.88339L10.66 7.96993C10.3846 8.17001 10.2694 8.52465 10.3746 8.84839L11.4715 12.2245C11.7067 12.9484 10.8782 13.5503 10.2624 13.1029L7.39054 11.0164C7.11516 10.8163 6.74226 10.8163 6.46688 11.0164L3.595 13.1029C2.97922 13.5503 2.1507 12.9484 2.3859 12.2245L3.48286 8.84839C3.58805 8.52465 3.47282 8.17001 3.19744 7.96993L0.325557 5.88339C-0.290219 5.436 0.026247 4.46201 0.787389 4.46201H4.33723C4.67762 4.46201 4.9793 4.24283 5.08449 3.91909L6.18145 0.542997Z" fill="currentColor"/>
                </svg>
              {% endfor %}
            </p>
          </div>
        </article>
      {%- endfor -%}

      {% for product in section.settings.product_list %}
        <article>
          <figure class="__media--wrapp">
            {%- if product.metafields.custom.badge != blank -%}
              <figcaption class="__badge">{{ product.metafields.custom.badge }}</figcaption>
            {%- endif -%}
            {%- assign img = product.metafields.custom.image_secondary | default: product.featured_image -%}
            {%- if img != blank -%}
              {%- assign img_alt = img.alt | default: product.title -%}
              {{- img | image_url: width: 1100 | image_tag: class: '__image', alt: img_alt, widths: '360, 550, 720, 1100', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' -}}
            {%- else -%}
              {{- 'image' | placeholder_svg_tag -}}
            {%- endif -%}
          </figure>

          <div class="__content--wrapp">
            <h3 class="__title">{{ product.metafields.custom.title_secondary | default: product.title | link_to: product.url }}</h3>
            <div class="__description">{{ product.description | strip_html | truncate: 100 }}</div>
            <p class="__price">{{ product.price | money }}</p>
            {%- form 'product', product, data-name-add-to-cart: 'true' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <button
                type="submit"
                class="btn__add-to-cart"
                {% unless product.available %}
                  disabled
                {% endunless %}
              >
                {%- if product.available -%}
                  {{ 'products.product.add_to_cart' | t }}
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
              <p class="__cart-error" role="alert" hidden></p>
            {%- endform -%}
          </div>
        </article>
      {% endfor %}

      {% for article in section.settings.blog.articles %}
        <article>
          <figure class="__media--wrapp">
            {%- if article.metafields.custom.badge != blank -%}
              <figcaption class="__badge">{{ article.metafields.custom.badge }}</figcaption>
            {%- endif -%}

            {%- if article.image != blank -%}
              {{ article.image | image_url: width: 1100 | image_tag: class: '__image', widths: '360, 550, 720, 1100', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy' }}
            {% else %}
              {{ 'image' | placeholder_svg_tag }}
            {%- endif -%}
          </figure>

          <div class="__content--wrapp">
            <p class="__author-data">
              <span>{{ article.author }}</span>
              {{ article.published_at | time_tag: '%d.%m.%Y' }}
            </p>
            <h3 class="__title">{{ article.title }}</h3>
            <div class="__description">{{ article.excerpt | strip_html | truncate: 100 }}</div>
            <a href="{{ article.url }}" aria-label="Read more: {{ article.title | escape }}">Read More</a>
          </div>
        </article>
      {% endfor %}
    </div>

    <div class="__accordion--wrapp">
      <div class="__accordion">
        {%- assign half_size = content_blocks.size | divided_by: 2.0 | ceil -%}
        <div>
          {%- for block in content_blocks limit: half_size -%}
            <details
              name="accordion-{{ section.id }}"
              {{ block.shopify_attributes }}
              {% if forloop.first %}
                open
              {% endif %}
            >
              <summary>
                {{ block.settings.title }}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M11.06 5.53 8 8.58 4.94 5.53 4 6.47l4 4 4-4-.94-.94Z" fill="currentColor"/>
                </svg>
              </summary>
              <div class="__accordion-content">{{ block.settings.description }}</div>
            </details>
          {%- endfor -%}
        </div>
        <div>
          {%- for block in content_blocks offset: half_size -%}
            <details name="accordion-{{ section.id }}" {{ block.shopify_attributes }}>
              <summary>
                {{ block.settings.title }}
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M11.06 5.53 8 8.58 4.94 5.53 4 6.47l4 4 4-4-.94-.94Z" fill="currentColor"/>
                </svg>
              </summary>
              <div class="__accordion-content">{{ block.settings.description }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>

    <div class="__tabs-wrapp">
      <div class="__tabs" data-name-tabs role="tablist">
        <button type="button" role="tab" aria-selected="true" aria-controls="tabs-panel-{{ section.id }}-1" id="tabs-tab-{{ section.id }}-1" tabindex="0">Part 1</button>
        <button type="button" role="tab" aria-selected="false" aria-controls="tabs-panel-{{ section.id }}-2" id="tabs-tab-{{ section.id }}-2" tabindex="-1">Part 2</button>
      </div>
      <div class="__tabs-content">
        <div class="__tabs-panel" data-name-tab-panel role="tabpanel" aria-labelledby="tabs-tab-{{ section.id }}-1" id="tabs-panel-{{ section.id }}-1" tabindex="0">content here 1</div>
        <div class="__tabs-panel" data-name-tab-panel role="tabpanel" aria-labelledby="tabs-tab-{{ section.id }}-2" id="tabs-panel-{{ section.id }}-2" tabindex="0" hidden>content here 2</div>
      </div>
    </div>
  </div>
</name-section>

{% schema %}
{
  "name": "Name",
  "class": "name",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme_1",
      "label": "Color Scheme"
    },
    {
      "type": "header",
      "content": "Main Title"
    },
    {
      "type": "richtext",
      "id": "title",
      "label": "Title"
    },
    {
      "type": "checkbox",
      "id": "show_advanced_settings",
      "label": "Show advanced settings Title",
      "default": false
    },
    {
      "type": "select",
      "id": "title_size",
      "label": "Title size",
      "options": [
        {
          "value": "h1-txt",
          "label": "H1"
        },
        {
          "value": "h2-txt",
          "label": "H2"
        },
        {
          "value": "h3-txt",
          "label": "H3"
        }
      ],
      "default": "h2-txt",
      "visible_if": "{{ section.settings.show_advanced_settings == true }}"
    },
    {
      "type": "text_alignment",
      "id": "title_align",
      "label": "Title align",
      "default": "center",
      "visible_if": "{{ section.settings.show_advanced_settings == true }}"
    },
    {
      "type": "select",
      "id": "title_font_family",
      "label": "Title font family",
      "options": [
        {
          "value": "var(--font-heading-family)",
          "label": "Heading font"
        },
        {
          "value": "var(--font-body-family)",
          "label": "Body font"
        }
      ],
      "default": "var(--font-heading-family)",
      "visible_if": "{{ section.settings.show_advanced_settings == true }}"
    },
    {
      "type": "richtext",
      "id": "subtitle",
      "label": "Subtitle"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "btn_name",
      "label": "Button name",
      "default": "Read More"
    },
    {
      "type": "url",
      "id": "btn_url",
      "label": "Button url"
    },
    {
      "type": "header",
      "content": "Responsive Image or Video"
    },
    {
      "type": "image_picker",
      "id": "image_desk",
      "label": "Image desktop",
      "info": "Image for display on the desktop"
    },
    {
      "type": "image_picker",
      "id": "image_mobi",
      "label": "Image mobile",
      "info": "Image for display on mobile"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Video for display on the desktop or mobile"
    },
    {
      "type": "select",
      "id": "banner_position",
      "label": "Banner layout",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" },
        { "value": "full", "label": "Full" },
        { "value": "split-left", "label": "Split-left" },
        { "value": "split-right", "label": "Split-right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "header",
      "content": "Blog"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "slider_columns",
      "min": 1,
      "max": 6,
      "step": 0.1,
      "default": 4,
      "label": "Slider slides per view"
    },
    {
      "type": "range",
      "id": "grid_columns",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Grid columns"
    },
    {
      "type": "header",
      "content": "Margin"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin top",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "label": "Margin bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    },
    {
      "type": "header",
      "content": "Mobile section padding"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "min": 0,
      "max": 300,
      "step": 5,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "max_blocks": 10,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "base_block",
      "name": "Base block",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "btn_name",
          "label": "Button name",
          "default": "Button"
        },
        {
          "type": "url",
          "id": "btn_url",
          "label": "Button url"
        },
        {
          "type": "number",
          "id": "number",
          "label": "Count",
          "default": 5
        },
        {
          "type": "range",
          "id": "col_span",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 1,
          "label": "Column span"
        },
        {
          "type": "range",
          "id": "row_span",
          "min": 1,
          "max": 4,
          "step": 1,
          "default": 1,
          "label": "Row span"
        }
      ]
    }
  ],
