{% comment %}
  Endpoint for snippets/cart-drawer-recommendations.liquid. Returns bare cards only:
  the snippet's script fetches it per cart product, merges the responses and de-dupes them.
  Each card has its own product form, so there is no wrapping <form>.
{% endcomment %}

{%- for product in recommendations.products -%}
  {%- unless product.available -%}{%- continue -%}{%- endunless -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  <div data-product-id="{{ product.id }}">
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true" draggable="false">
      {%- if product.featured_media -%}
        {{-
          product.featured_media
          | image_url: width: 160
          | image_tag: loading: 'lazy', widths: '80,160', sizes: '80px', alt: '', draggable: 'false'
        -}}
      {%- endif -%}
    </a>
    <div>
      <a href="{{ product.url }}" draggable="false">{{ product.title | escape }}</a>
      <div>
        <span>
          {%- if variant.compare_at_price > variant.price -%}
            <s>{{ variant.compare_at_price | money }}</s>
          {%- endif -%}
          {{ variant.price | money }}
        </span>
        {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ variant.id }}">
          <button type="submit">{{ 'products.product.add_to_cart' | t }}</button>
        {%- endform -%}
      </div>
      <small role="alert" hidden></small>
    </div>
  </div>
{%- endfor -%}

{% schema %}
{
  "name": "Cart recommendations"
}
{% endschema %}
