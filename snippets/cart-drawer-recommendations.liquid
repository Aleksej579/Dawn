{% comment %}
  Cross-sell slider for the cart drawer: complementary products of every cart item, one card
  visible with the next one peeking. Self-contained: markup, styles and script live here;
  the cards come from sections/cart-drawer-recommendations.liquid.

  Usage:
    {% render 'cart-drawer-recommendations' %}
    {% render 'cart-drawer-recommendations', heading: 'You may also like', limit: 4 %}

  Needs: settings.cart_show_recommendations, locale key sections.cart.recommendations_heading,
  the Search & Discovery app for the recommendations, and a Dawn-style <cart-drawer>
  (renderContents / getSectionsToRender); without it the "Add" form posts natively.

  Why the script is inline: markup swapped in via innerHTML never runs its scripts, so the
  element must be defined on first page load. That is why the style/script are emitted even
  while the cart is empty.

  Recommendations are fetched for the first 4 cart products, cached per request for the page
  lifetime, and fall back to intent=related when nothing complementary is configured.

  TODO if needed: hand-picked fallback products; arrows/dots; per-card variant picker.
{% endcomment %}

{%- if settings.cart_show_recommendations -%}
  {%- if cart.item_count > 0 -%}
    <cart-drawer-recommendations
      data-url="{{ routes.product_recommendations_url }}?section_id=cart-drawer-recommendations&limit={{ limit | default: 3 }}"
      data-ids="{{ cart.items | map: 'product_id' | uniq | join: ',' }}"
    >
      <div hidden>
        <p role="heading" aria-level="2">{% if heading %}{{ heading }}{% else %}{{ 'sections.cart.recommendations_heading' | t }}{% endif %}</p>
        <div role="list"></div>
      </div>
    </cart-drawer-recommendations>
  {%- endif -%}

  <style>
    cart-drawer-recommendations {
      /* Theme tokens live here only: remap these when porting to another theme. */
      --recs-color: rgb(var(--color-foreground));
      --recs-muted: rgba(var(--color-foreground), 0.6);
      --recs-line: rgba(var(--color-foreground), 0.2);
      --recs-error: #b00020;
      --recs-card-bg: rgba(var(--color-foreground), 0.05);
      --recs-button-bg: rgb(var(--color-button));
      --recs-button-text: rgb(var(--color-button-text));

      display: block;

      > div {
        padding: 1.5rem 0;
        border-top: 0.1rem solid var(--recs-line);
      }

      > div[hidden] {
        display: none;
      }

      & p {
        margin: 0 0 1.2rem;
        font-size: 1.3rem;
        letter-spacing: 0.1rem;
        text-transform: uppercase;
        color: var(--recs-muted);
      }

      /* Track: native scroll + snap; a mouse drag resolves to one step (see script). */
      [role='list'] {
        display: flex;
        gap: 1.6rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        cursor: grab;
        user-select: none;
      }

      [role='list']::-webkit-scrollbar {
        display: none;
      }

      [role='list'].is-dragging {
        cursor: grabbing;
      }

      /* Card: image left; title, price and button right. 85% wide so the next card peeks in. */
      [role='list'] > * {
        display: flex;
        flex: none;
        gap: 1.2rem;
        box-sizing: border-box;
        width: 85%;
        max-width: 35.6rem;
        padding: 0.8rem 1.2rem 0.8rem 0.8rem;
        background: var(--recs-card-bg);
        scroll-snap-align: center;
      }

      [role='list'] > * > a {
        flex: none;
        width: 8rem;
        height: 8rem;
      }

      & img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        -webkit-user-drag: none;
      }

      [role='list'] > * > div {
        display: flex;
        flex: 1;
        flex-direction: column;
        justify-content: center;
        gap: 0.8rem;
        min-width: 0;
      }

      [role='list'] > * > div > a {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 1.4rem;
        line-height: 1.4;
        color: var(--recs-color);
        text-decoration: none;
      }

      [role='list'] > * > div > div {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.8rem;
        font-size: 1.4rem;
      }

      & s {
        margin-right: 0.4rem;
        opacity: 0.5;
      }

      & form {
        margin: 0;
      }

      & button {
        padding: 0.4rem 1.2rem 0.5rem;
        border: 0;
        background: var(--recs-button-bg);
        color: var(--recs-button-text);
        font-size: 1.2rem;
        cursor: pointer;
      }

      & small {
        color: var(--recs-error);
        font-size: 1.2rem;
      }

      & a:hover {
        text-decoration: underline;
      }

      & a:focus-visible,
      & button:focus-visible {
        outline: 0.2rem solid var(--recs-color);
        outline-offset: 0.2rem;
      }

      & button:disabled {
        opacity: 0.5;
        cursor: default;
      }
    }
  </style>

  <script>
    if (!customElements.get('cart-drawer-recommendations')) {
      const requests = new Map(); // url -> html; the drawer is re-rendered on every cart change
      const request = (url) => {
        if (!requests.has(url)) {
          requests.set(
            url,
            fetch(url)
              .then((response) => (response.ok ? response.text() : Promise.reject()))
              .catch(() => (requests.delete(url), ''))
          );
        }
        return requests.get(url);
      };

      customElements.define(
        'cart-drawer-recommendations',
        class extends HTMLElement {
          connectedCallback() {
            this.abort = new AbortController();
            this.track = this.querySelector('[role="list"]');
            // The drawer is re-rendered after every cart change, so this element reconnects and
            // reloads on its own. Load only once it is about to be visible (the drawer starts off-screen).
            this.observer = new IntersectionObserver(
              ([entry], observer) => {
                if (!entry.isIntersecting) return;
                observer.disconnect();
                this.load();
              },
              { rootMargin: '0px 0px 400px 0px' }
            );
            this.observer.observe(this);
            this.track.addEventListener('submit', (event) => this.add(event), { signal: this.abort.signal });
            this.enableDrag();
          }

          disconnectedCallback() {
            this.abort.abort();
            this.observer.disconnect();
          }

          async load() {
            const cartIds = this.dataset.ids.split(',');
            const seen = new Set(cartIds); // products already in the cart are never recommended

            const collect = async (intent) => {
              const pages = await Promise.all(
                cartIds.slice(0, 4).map((id) => request(`${this.dataset.url}&intent=${intent}&product_id=${id}`))
              );
              if (!this.isConnected) return;
              pages.forEach((html) => {
                const holder = document.createElement('div');
                holder.innerHTML = html;
                holder.querySelectorAll('[data-product-id]').forEach((card) => {
                  if (seen.has(card.dataset.productId)) return;
                  seen.add(card.dataset.productId);
                  card.setAttribute('role', 'listitem');
                  this.track.append(card);
                });
              });
            };

            await collect('complementary');
            if (!this.track.children.length) await collect('related');
            this.firstElementChild.hidden = !this.track.children.length;
          }

          add(event) {
            const cart = document.querySelector('cart-drawer');
            if (!cart?.renderContents) return; // not a Dawn drawer: let the form post natively
            event.preventDefault();

            const button = event.target.querySelector('button');
            button.disabled = true;
            const body = new FormData(event.target);
            body.append('sections', cart.getSectionsToRender().map((section) => section.id));
            body.append('sections_url', location.pathname);

            fetch(`${window.Shopify.routes.root}cart/add.js`, {
              method: 'POST',
              headers: { 'X-Requested-With': 'XMLHttpRequest', Accept: 'application/json' },
              body,
            })
              .then((response) => response.json())
              .then((data) => {
                if (!data.status) return cart.renderContents(data);
                // e.g. not enough stock: show the reason under the card
                const note = event.target.closest('[data-product-id]').querySelector('small');
                note.textContent = data.description;
                note.hidden = false;
                button.disabled = false;
              })
              .catch(() => (button.disabled = false));
          }

          // Mouse only (touch already swipes natively). The track is not moved while dragging:
          // the drag is measured and, on release, resolves to one step to the adjacent card.
          enableDrag() {
            const { signal } = this.abort;
            const track = this.track;
            let startX = null;
            let lastX = 0;
            let moved = false;

            const end = (cancelled) => {
              if (startX === null) return;
              const delta = lastX - startX;
              startX = null;
              track.classList.remove('is-dragging');
              if (!cancelled && Math.abs(delta) > 40) {
                const width = track.firstElementChild.offsetWidth + 16; // card + gap
                track.scrollBy({ left: delta < 0 ? width : -width });
              }
              requestAnimationFrame(() => (moved = false));
            };

            track.addEventListener(
              'pointerdown',
              (event) => {
                if (event.pointerType !== 'mouse') return;
                startX = lastX = event.clientX;
                moved = false;
                track.classList.add('is-dragging');
              },
              { signal }
            );
            window.addEventListener(
              'pointermove',
              (event) => {
                if (startX === null) return;
                lastX = event.clientX;
                moved ||= Math.abs(lastX - startX) > 5;
              },
              { signal }
            );
            window.addEventListener('pointerup', () => end(false), { signal });
            window.addEventListener('pointercancel', () => end(true), { signal });
            window.addEventListener('blur', () => end(true), { signal });
            // A drag must not also follow a link or press "Add".
            track.addEventListener(
              'click',
              (event) => {
                if (!moved) return;
                event.preventDefault();
                event.stopPropagation();
              },
              { capture: true, signal }
            );
          }
        }
      );
    }
  </script>
{%- endif -%}
